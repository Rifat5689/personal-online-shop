NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/personalshop_test
STORE_SLUG=originsofbeauty
DB_MIRROR_ENABLED=false
DATABASE_ROLE=local
ACCESS_TOKEN_SECRET=replace-with-random-secret
REFRESH_TOKEN_SECRET=replace-with-different-random-secret
CORS_ORIGIN=http://localhost:3001
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=personalshop-test
# WhatsApp Cloud API — backend only. Never use VITE_ prefixes for these values.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Optional: only the testing app uses this to relay signed events to production.
WHATSAPP_WEBHOOK_RELAY_URL=
# Optional environment fallback; a saved encrypted UI key takes precedence.
GEMINI_API_KEY=
# Random 32-byte base64 key required before saving a Gemini key through the UI.
WHATSAPP_AI_ENCRYPTION_KEY=
