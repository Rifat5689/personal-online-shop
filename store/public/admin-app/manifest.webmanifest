{
  "id": "/admin-app",
  "name": "Origins Admin",
  "short_name": "Origins Admin",
  "description": "Secure store management for Origins of Beauty administrators.",
  "start_url": "/secure/admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f7fb",
  "theme_color": "#04243a",
  "lang": "en",
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "/admin-app/manifest.webmanifest", "id": "/admin-app" }
  ],
  "icons": [
    { "src": "/admin-app/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-app/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-app/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
